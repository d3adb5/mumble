# Builds the Mumble client from the clone this file lives in: run makepkg in this
# directory and it packages that clone's checked-out commit (commit your changes first,
# uncommitted ones are not picked up). See README.md next to this file.
#
# Environment variables:
#   MUMBLE_MARCH         Build for a specific CPU instead of the flags in makepkg.conf, like
#                        CachyOS' optimized repositories do: x86-64, x86-64-v2, x86-64-v3,
#                        x86-64-v4, znver3, znver4, ... (anything GCC's -march and rustc's
#                        target-cpu both accept). Builds with -O3, as CachyOS does.
#   MUMBLE_BUILD_NUMBER  The build number to stamp into the version (CI uses the one of the
#                        release). Without it, it is taken from the latest v1.7.<n> tag.

_pkgname=mumble
pkgname="$_pkgname-git"
pkgver=1.7.66.r317.g8a4a8a22f
pkgrel=1
epoch=1
pkgdesc='An Open Source, low-latency, high quality voice chat software (d3adb5 fork, git version)'
arch=('x86_64')
url='https://github.com/d3adb5/mumble'
license=('BSD-3-Clause')
depends=('glibc' 'libgcc' 'libstdc++' 'qt6-base')
makedepends=('alsa-lib' 'avahi' 'boost' 'cli11' 'cmake' 'git' 'hicolor-icon-theme'
             'jack' 'lib32-gcc-libs' 'libpulse' 'libsndfile' 'libspeechd'
             'libx11' 'libxi' 'mesa' 'nlohmann-json' 'ninja' 'openssl'
             'opus' 'poco' 'protobuf' 'python' 'qt6-svg' 'qt6-tools' 'rnnoise'
             'rust' 'spdlog' 'speech-dispatcher' 'speexdsp' 'utf8cpp' 'xdg-utils'
             'gstreamer' 'gst-plugins-base-libs')
provides=("$_pkgname")
conflicts=("$_pkgname")
# The repository this PKGBUILD is part of (two levels up).
_repo="$(realpath "${startdir:-$PWD}/../..")"
source=("$_pkgname::git+file://$_repo")
sha256sums=('SKIP')

_build_number() {
  if [[ -n "$MUMBLE_BUILD_NUMBER" ]]; then
    printf '%s' "$MUMBLE_BUILD_NUMBER"
  else
    # The fork's releases are tagged v<major>.<minor>.<build number>
    local tag
    tag="$(git -C "$srcdir/$_pkgname" describe --tags --abbrev=0 --match 'v[0-9]*.[0-9]*.[0-9]*' 2>/dev/null)"
    printf '%s' "${tag##*.}" | grep -E '^[0-9]+$' || printf '0'
  fi
}

pkgver() {
  cd "$_pkgname"
  if [[ -n "$MUMBLE_BUILD_NUMBER" ]]; then
    printf '%s.%s' "$(python scripts/mumble-version.py)" "$MUMBLE_BUILD_NUMBER"
  else
    git describe --long --tags --match 'v[0-9]*' | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
  fi
}

prepare() {
  cd "$_pkgname"

  # Take the submodules from the clone we build when it has them checked out, so that a
  # build needs no network access for them; fall back to their upstream URLs otherwise.
  git submodule init
  local name path
  while read -r name path; do
    name="${name#submodule.}"
    name="${name%.path}"
    if [[ -e "$_repo/$path/.git" ]]; then
      git config "submodule.$name.url" "$_repo/$path"
    fi
  done < <(git config -f .gitmodules --get-regexp '^submodule\..*\.path$')

  git -c protocol.file.allow=always submodule update
}

build() {
  # DeepFilterNet3 and the crates it pulls in are built with Cargo, which needs a
  # toolchain to be selected explicitly: with rustup installed, "cargo" is a shim
  # that resolves to whatever the user happens to have set as their default.
  export RUSTUP_TOOLCHAIN='stable'

  if [[ -n "$MUMBLE_MARCH" ]]; then
    local tune="$MUMBLE_MARCH"
    # A microarchitecture level names no CPU to tune for.
    [[ "$MUMBLE_MARCH" == x86-64* ]] && tune='generic'

    local var flags
    for var in CFLAGS CXXFLAGS; do
      flags=" ${!var} "
      flags="$(sed -E 's/ -(march|mtune)=[^ ]+/ /g; s/ -O[0-9s]? / /g' <<< "$flags")"
      printf -v "$var" '%s' "$flags -march=$MUMBLE_MARCH -mtune=$tune -O3"
      export "$var"
    done
    # Cargo is always given an explicit --target by Corrosion, so these only reach the
    # library that ends up in Mumble, never the build scripts that run on this machine.
    export RUSTFLAGS="${RUSTFLAGS:-} -C target-cpu=$MUMBLE_MARCH"
  fi

  # Mumble's dependency provider uses the system's libraries (the makedepends) and only
  # fetches one that is missing.
  cmake \
    -B build-client \
    -S "$_pkgname" \
    -G Ninja \
    -DCMAKE_PROJECT_TOP_LEVEL_INCLUDES="$srcdir/$_pkgname/cmake/mumble_dependency_provider.cmake" \
    -DCMAKE_BUILD_TYPE='None' \
    -DCMAKE_INSTALL_PREFIX='/usr' \
    -DBUILD_NUMBER="$(_build_number)" \
    -Dwarnings-as-errors='OFF' \
    -Dclient='ON' \
    -Dserver='OFF' \
    -Dtests='ON' \
    -Dbundled-rnnoise='OFF' \
    -Dbundled-speex='OFF' \
    -Dwebrtc-audio-processing='ON' \
    -Ddeepfilternet='ON' \
    -Dwebcam='ON' \
    -Dupdate='OFF' \
    -Wno-dev

  cmake --build build-client
}

check() {
  QT_QPA_PLATFORM=offscreen ctest --test-dir build-client --output-on-failure
}

package() {
  # NOTE: jack, libpulse, and pipewire are dlopen'ed
  depends+=(
    'alsa-lib' 'libasound.so'
    'avahi' 'libdns_sd.so'
    'hicolor-icon-theme'
    'jack'
    'protobuf' 'libprotobuf.so'
    'libpulse'
    'libsndfile' 'libsndfile.so'
    'libspeechd'
    'libx11'
    'libxi'
    'openssl' 'libcrypto.so' 'libssl.so'
    'opus' 'libopus.so'
    'poco'
    'qt6-svg'
    'rnnoise'
    'spdlog'
    'speexdsp' 'libspeexdsp.so'
    'xdg-utils'
    # Webcam sharing: linked libraries, then the elements its pipelines use
    'glib2' 'gstreamer'
    'gst-plugins-base-libs' # also videoconvertscale, videorate, decodebin, appsink
    'gst-plugins-good'      # v4l2src, jpegdec, rtspsrc, rtph264depay
    'gst-plugins-bad-libs'  # h264parse
    'gst-plugins-bad'       # openh264enc/dec
    'gst-rtsp-server'       # rtspclientsink
    'glib-networking'       # TLS for rtsps
  )
  optdepends=(
    'gst-plugins-ugly: x264 encoder for webcam sharing'
    'gst-plugin-va: hardware H.264 encoding and decoding for webcam sharing'
    'gst-libav: FFmpeg H.264 decoder for watching webcams'
    'lib32-glibc: For mumble-overlay'
    'espeak-ng: Text-to-speech support'
    'speech-dispatcher: Text-to-speech support'
    'pipewire: PipeWire audio support'
  )

  DESTDIR="$pkgdir" cmake --install build-client
  install -Dm 644 "$_pkgname/LICENSE" -t "$pkgdir/usr/share/licenses/$_pkgname/"
}
