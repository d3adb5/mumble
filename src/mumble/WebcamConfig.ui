      </item>
      <item row="1" column="1">
       <layout class="QHBoxLayout" name="qhlDevice">
        <item>
         <widget class="QComboBox" name="qcbDevice">
          <property name="sizePolicy">
           <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
