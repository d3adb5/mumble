         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="qpbPreview">
          <property name="toolTip">
           <string>See the camera as it would be sent at the chosen quality. Only you see it: nothing is sent.</string>
          </property>
          <property name="text">
           <string>Preview</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="qlQuality">
        <property name="text">
         <string>Quality</string>
        </property>
        <property name="buddy">
         <cstring>qcbQuality</cstring>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QComboBox" name="qcbQuality">
        <property name="toolTip">
         <string>What your camera is sent at. Lower settings use less data for you and your viewers.</string>
        </property>
       </widget>
      </item>
      <item row="3" column="0">
       <widget class="QLabel" name="qlCustomHeight">
        <property name="text">
         <string>Height</string>
        </property>
        <property name="buddy">
         <cstring>qsbCustomHeight</cstring>
        </property>
       </widget>
      </item>
      <item row="3" column="1">
       <widget class="QSpinBox" name="qsbCustomHeight">
        <property name="suffix">
         <string> px</string>
