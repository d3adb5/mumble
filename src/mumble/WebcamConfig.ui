      <item row="6" column="1">
       <widget class="QComboBox" name="qcbEncoder"/>
      </item>
      <item row="7" column="0" colspan="2">
       <widget class="QCheckBox" name="qcbOnDemand">
        <property name="toolTip">
         <string>Keep the camera (and its light) off while you share and nobody is watching, and send nothing to the relay</string>
        </property>
        <property name="text">
         <string>Open the camera only while someone is watching</string>
        </property>
       </widget>
      </item>
      <item row="8" column="0" colspan="2">
       <widget class="QCheckBox" name="qcbPreview">
        <property name="toolTip">
         <string>Open a window with your own camera when you start sharing. Only you see it; you can also open it from the Self menu.</string>
        </property>
        <property name="text">
         <string>Show my camera while I share it</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="qgbRelay">
     <property name="title">
      <string>Relay</string>
     </property>
     <layout class="QFormLayout" name="qflRelay">
      <item row="0" column="0" colspan="2">
       <widget class="QLabel" name="qlRelayInfo">
        <property name="text">
         <string>Your camera is sent to a MediaMTX relay over RTSPS, on a new random path every time, and encrypted end to end: the relay never sees the picture. The relay wants your own login to share and to watch; watching needs no camera and no sharing.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="qlRelay">
        <property name="text">
         <string>Address</string>
        </property>
        <property name="buddy">
         <cstring>qleRelay</cstring>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QLineEdit" name="qleRelay">
        <property name="toolTip">
         <string>The relay's RTSPS address. Without a port, 8322 (MediaMTX's RTSPS port) is used.</string>
        </property>
        <property name="placeholderText">
         <string>rtsps://relay.example.org:8322</string>
        </property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="qlPublishUser">
        <property name="text">
         <string>Your login</string>
        </property>
        <property name="buddy">
         <cstring>qlePublishUser</cstring>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <layout class="QHBoxLayout" name="qhlPublish">
        <item>
         <widget class="QLineEdit" name="qlePublishUser">
          <property name="toolTip">
           <string>Your own login on the relay: it publishes your camera and reads the cameras you watch</string>
          </property>
          <property name="placeholderText">
           <string>User</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QLineEdit" name="qlePublishPassword">
          <property name="echoMode">
           <enum>QLineEdit::Password</enum>
          </property>
          <property name="placeholderText">
           <string>Password</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item row="3" column="0">
       <widget class="QLabel" name="qlReadUser">
        <property name="text">
         <string>Read login</string>
        </property>
        <property name="buddy">
         <cstring>qleReadUser</cstring>
        </property>
       </widget>
      </item>
      <item row="3" column="1">
       <layout class="QHBoxLayout" name="qhlRead">
        <item>
         <widget class="QLineEdit" name="qleReadUser">
          <property name="toolTip">
           <string>Only for relays that give viewers a shared read login: it is given to each viewer you let in, sealed to them, and used instead of their own</string>
          </property>
          <property name="placeholderText">
           <string>User (optional)</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QLineEdit" name="qleReadPassword">
          <property name="echoMode">
           <enum>QLineEdit::Password</enum>
          </property>
          <property name="placeholderText">
           <string>Password</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item row="4" column="0">
       <widget class="QLabel" name="qlCaFile">
        <property name="text">
         <string>Trusted CA</string>
        </property>
        <property name="buddy">
         <cstring>qleCaFile</cstring>
        </property>
       </widget>
      </item>
      <item row="4" column="1">
       <layout class="QHBoxLayout" name="qhlCaFile">
        <item>
         <widget class="QLineEdit" name="qleCaFile">
          <property name="toolTip">
           <string>A PEM file of certificate authorities to trust for relays, when theirs is not one the system trusts. Used for watching as well.</string>
          </property>
          <property name="placeholderText">
           <string>The system's (optional)</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="qpbCaFile">
          <property name="text">
           <string>Browse…</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item row="5" column="0">
       <widget class="QLabel" name="qlGateUrl">
        <property name="text">
         <string>Relay gate</string>
        </property>
        <property name="buddy">
         <cstring>qleGateUrl</cstring>
        </property>
       </widget>
      </item>
      <item row="5" column="1">
       <widget class="QLineEdit" name="qleGateUrl">
        <property name="toolTip">
         <string>Where the relay's gate API is, if it has one and it is not at the relay's own host. Your login is sent there, so set only an address you trust. HTTPS only.</string>
        </property>
        <property name="placeholderText">
         <string>https://&lt;relay host&gt;/gate/v1 (optional)</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
