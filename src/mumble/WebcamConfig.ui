        <property name="minimum">
         <number>96</number>
        </property>
        <property name="maximum">
         <number>2160</number>
        </property>
        <property name="singleStep">
         <number>16</number>
        </property>
       </widget>
      </item>
      <item row="4" column="0">
       <widget class="QLabel" name="qlCustomFps">
        <property name="text">
